# n8n 配置
N8N_WEBHOOK_URL=https://n8n.aishuohua.art/webhook/wechat-bot
N8N_API_KEY=

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 微信配置
WECHAT_API_BASE=http://127.0.0.1:52700/wechat-plugin/

# 机器人配置
BOT_NAME=阿祖
MENTION_TRIGGER=@阿祖
POLL_INTERVAL=2

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# 数据存储
DATA_DIR=data
CONTEXT_MAX_HISTORY=20
CONTEXT_TTL=86400
